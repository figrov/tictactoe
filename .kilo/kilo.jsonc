{
  "$schema": "https://kilo.ai",
  "default_agent": "delivarable-man",
  "snapshot": false,
  "permission": {
    "edit": "allow",
    "doom_loop": "ask",
    "bash": "allow"
  },
  "agent": {
    "delivarable-man": {
      "steps": 30
    },
    "game-analyst": {
      "steps": 15
    },
    "android-dev": {
      "steps": 30
    },
    "build-controller": {
      "steps": 20
    },
    "qa-engineer": {
      "steps": 25
    }
  }
}